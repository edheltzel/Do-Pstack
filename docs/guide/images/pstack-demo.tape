# FM-528 — full demo (may hang in omp TUI under vhs)
Output "/Users/ed/Developer/pstack-vhs/pstack-demo.gif"
Require omp
Require bash
Set FontSize 18
Set Width 1200
Set Height 700
Set Padding 16
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms
Set Shell bash
Hide
Type "clear"
Enter
Sleep 400ms
Show
Type "omp plugin list"
Enter
Sleep 1.5s
Type "omp plugin doctor"
Enter
Sleep 2.5s
Type "omp"
Enter
Sleep 2.5s
Type "/poteto-mode"
Enter
Sleep 2.5s
Type "/"
Sleep 1s
Type "skill:do-"
Sleep 1.8s
Backspace 20
Type "/skill:do-how"
Sleep 1.2s
Sleep 2s
Ctrl+C
Sleep 400ms
Type "exit"
Enter
Sleep 300ms
